{
  "name": "ssrmock-toolbox-dev",
  "version": "1.1.0",
  "private": true,
  "description": "把根目录的 HBuilderX 工程用 uni-app CLI 跑在浏览器里的运行器：源码仍在仓库根目录，这里只放构建依赖",
  "scripts": {
    "postinstall": "node scripts/patch-compiler-utils.js",
    "patch": "node scripts/patch-compiler-utils.js",
    "dev:h5": "cross-env NODE_ENV=development UNI_PLATFORM=h5 UNI_INPUT_DIR=.. UNI_CLI_CONTEXT=. NODE_OPTIONS=--openssl-legacy-provider vue-cli-service uni-serve --port 5273",
    "build:h5": "cross-env NODE_ENV=production UNI_PLATFORM=h5 UNI_INPUT_DIR=.. UNI_CLI_CONTEXT=. NODE_OPTIONS=--openssl-legacy-provider vue-cli-service uni-build"
  },
  "dependencies": {
    "@dcloudio/uni-app": "2.0.2-5030320261023001",
    "@dcloudio/uni-h5": "2.0.2-5030320261023001",
    "@dcloudio/uni-i18n": "2.0.2-5030320261023001",
    "core-js": "^3.6.5",
    "regenerator-runtime": "^0.12.1",
    "vue": "2.6.14"
  },
  "devDependencies": {
    "@dcloudio/uni-cli-i18n": "2.0.2-5030320261023001",
    "@dcloudio/uni-cli-shared": "2.0.2-5030320261023001",
    "@dcloudio/uni-migration": "2.0.2-5030320261023001",
    "@dcloudio/uni-stat": "2.0.2-5030320261023001",
    "@dcloudio/uni-template-compiler": "2.0.2-5030320261023001",
    "@dcloudio/vue-cli-plugin-uni": "2.0.2-5030320261023001",
    "@dcloudio/webpack-uni-mp-loader": "2.0.2-5030320261023001",
    "@dcloudio/webpack-uni-pages-loader": "2.0.2-5030320261023001",
    "@vue/cli-plugin-babel": "4.5.19",
    "@vue/cli-service": "4.5.19",
    "autoprefixer": "9.8.8",
    "babel-plugin-import": "^1.11.0",
    "cache-loader": "4.1.0",
    "copy-webpack-plugin": "5.1.2",
    "cross-env": "^7.0.2",
    "file-loader": "4.3.0",
    "html-webpack-plugin": "3.2.0",
    "mini-css-extract-plugin": "0.9.0",
    "postcss": "7.0.39",
    "postcss-comment": "^2.0.0",
    "postcss-import": "12.0.1",
    "sass": "^1.60.0",
    "sass-loader": "^8.0.2",
    "thread-loader": "2.1.3",
    "url-loader": "2.3.0",
    "vue-style-loader": "4.1.3",
    "vue-template-compiler": "2.6.14",
    "webpack": "4.47.0",
    "webpack-dev-server": "3.11.3"
  }
}
